@model AdminTelegramViewModel
@{
    ViewData["Title"] = "Telegram settings";
}
<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Telegram bot settings</h1>
        <p class="subtitle mb-0">Configure the Telegram bot token, webhook, and bot username. Users link accounts from Messaging in the main app.</p>
    </div>
</section>

<div class="panel mb-4">
    <p class="eyebrow">Configuration</p>
    <h2 class="h6 mb-3">Bot credentials</h2>
    <form asp-action="SaveSettings" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Bot token (override)</label>
            <input type="password" name="botTokenOverride" class="form-control" placeholder="Leave blank to keep current" autocomplete="off" />
            @if (!string.IsNullOrEmpty(Model.BotTokenFromConfig))
            {
                <div class="form-text">@Model.BotTokenFromConfig from appsettings / user secrets</div>
            }
            <div class="form-text">Create a bot via <a href="https://t.me/BotFather" target="_blank" rel="noopener noreferrer">BotFather</a> and paste the token here.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Webhook secret</label>
            <input type="password" name="webhookSecretOverride" class="form-control" value="@Model.WebhookSecretOverride" placeholder="Random secret string" autocomplete="off" />
            @if (!string.IsNullOrEmpty(Model.WebhookSecretFromConfig))
            {
                <div class="form-text">@Model.WebhookSecretFromConfig from appsettings</div>
            }
            <div class="form-text">Must match the secret sent when registering the webhook with Telegram.</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Bot username</label>
            <input type="text" name="botUsernameOverride" class="form-control" value="@(string.IsNullOrEmpty(Model.BotUsernameOverride) ? Model.BotUsernameFromConfig : Model.BotUsernameOverride)" placeholder="MyFintraqBot (without @@)" />
            <div class="form-text">Used for deep links on the user Messaging page (t.me/username).</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Webhook URL</label>
            <input type="url" name="webhookUrlOverride" class="form-control" value="@(string.IsNullOrEmpty(Model.WebhookUrlOverride) ? Model.EffectiveWebhookUrl : Model.WebhookUrlOverride)" placeholder="https://your-domain/api/webhooks/telegram" />
            @if (!string.IsNullOrEmpty(Model.WebhookUrlFromConfig))
            {
                <div class="form-text">appsettings default: @Model.WebhookUrlFromConfig</div>
            }
            <div class="form-text">Public HTTPS URL where Telegram sends messages. Default for this host: <code>@Model.EffectiveWebhookUrl</code></div>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>

<div class="panel mb-4">
    <p class="eyebrow">Webhook</p>
    <h2 class="h6 mb-2">Register with Telegram</h2>
    <p class="small text-body-secondary mb-2">@Model.WebhookStatus</p>
    <form asp-action="RegisterWebhook" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary" @(Model.IsConfigured ? null : "disabled")>Register webhook now</button>
    </form>
    @if (!Model.IsConfigured)
    {
        <div class="form-text mt-2">Save a bot token first.</div>
    }
</div>

<div class="panel">
    <p class="eyebrow">User linking</p>
    <h2 class="h6 mb-2">How users connect</h2>
    <ol class="small text-body-secondary mb-0">
        <li>Users log in → <strong>Messaging</strong> in the main nav</li>
        <li>Generate a link code</li>
        <li>Send <code>/link CODE</code> to your Telegram bot</li>
    </ol>
</div>
