@model AdminAiViewModel
@using ExpenseManager.Models.Ai
@using System.Text.Json
@{
    ViewData["Title"] = "AI settings";
    var providerJson = JsonSerializer.Serialize(
        Model.ProviderSettings.ToDictionary(
            kvp => kvp.Key.ToString(),
            kvp => new
            {
                hasStoredKey = !string.IsNullOrEmpty(kvp.Value.ApiKeyOverride),
                apiKeyFromConfig = kvp.Value.ApiKeyFromConfig,
                model = kvp.Value.Model,
                availableModels = kvp.Value.AvailableModels,
                helpText = kvp.Value.HelpText
            }));
}
<section class="page-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>AI settings</h1>
        <p class="subtitle mb-0">Choose provider (Gemini, Anthropic, Cursor), API key, model, and view token usage.</p>
    </div>
</section>

<div class="panel mb-4">
    <p class="eyebrow">Configuration</p>
    <h2 class="h6 mb-3">Provider, API key &amp; model</h2>
    <form asp-action="SaveSettings" method="post" id="adminAiForm">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" for="providerSelect">Active provider</label>
            <select name="provider" id="providerSelect" class="form-select">
                @foreach (var p in Enum.GetValues<AiProvider>())
                {
                    <option value="@p" selected="@(p == Model.Provider)">@p</option>
                }
            </select>
            <div class="form-text">Chat, messaging bots, and AI assistant use the selected provider.</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="apiKeyOverride" id="apiKeyLabel">@Model.Provider API key (override)</label>
            <input type="password"
                   name="apiKeyOverride"
                   id="apiKeyOverride"
                   class="form-control"
                   value=""
                   placeholder="Leave blank to keep current"
                   autocomplete="off" />
            <div class="form-text" id="apiKeyFromConfigHint" @(string.IsNullOrEmpty(Model.ApiKeyFromConfig) ? "hidden" : "")>
                <span id="apiKeyFromConfigText">@Model.ApiKeyFromConfig</span> from appsettings
            </div>
            <div class="form-text" id="apiKeyHelpText">@Model.ProviderSettings[Model.Provider].HelpText</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="modelSelect">Model</label>
            <select name="model" id="modelSelect" class="form-select">
                @foreach (var m in Model.AvailableModels)
                {
                    <option value="@m" selected="@(m == Model.Model)">@m</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>

<div class="panel mb-4">
    <p class="eyebrow">Usage</p>
    <h2 class="h6 mb-2">Token usage</h2>
    <p class="mb-2">Total calls: <strong>@Model.TotalCalls</strong> &middot; Prompt tokens: <strong>@Model.TotalPromptTokens</strong> &middot; Completion tokens: <strong>@Model.TotalCompletionTokens</strong></p>
    <a asp-action="TokenHistory" class="btn btn-outline-secondary btn-sm">View full history</a>
</div>

<div class="panel">
    <p class="eyebrow">History</p>
    <h2 class="h6 mb-3">Recent token history</h2>
    <div>
        @if (Model.TokenHistory.Count == 0)
        {
            <p class="p-3 mb-0 text-muted">No AI calls recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Time (UTC)</th>
                            <th>User</th>
                            <th>Model</th>
                            <th>Prompt</th>
                            <th>Completion</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.TokenHistory)
                        {
                            <tr>
                                <td>@h.CalledAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><code>@h.UserId.Substring(0, Math.Min(8, h.UserId.Length))…</code></td>
                                <td>@h.Model</td>
                                <td>@h.PromptTokens</td>
                                <td>@h.CompletionTokens</td>
                                <td>@h.TotalTokens</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const providerSettings = @Html.Raw(providerJson);
            const providerSelect = document.getElementById('providerSelect');
            const apiKeyLabel = document.getElementById('apiKeyLabel');
            const apiKeyInput = document.getElementById('apiKeyOverride');
            const apiKeyFromConfigHint = document.getElementById('apiKeyFromConfigHint');
            const apiKeyFromConfigText = document.getElementById('apiKeyFromConfigText');
            const apiKeyHelpText = document.getElementById('apiKeyHelpText');
            const modelSelect = document.getElementById('modelSelect');

            function applyProvider(provider) {
                const settings = providerSettings[provider];
                if (!settings) return;

                apiKeyLabel.textContent = provider + ' API key (override)';
                apiKeyInput.value = '';
                apiKeyInput.placeholder = settings.hasStoredKey
                    ? 'Leave blank to keep current key'
                    : 'Enter API key';

                if (settings.apiKeyFromConfig) {
                    apiKeyFromConfigText.textContent = settings.apiKeyFromConfig;
                    apiKeyFromConfigHint.hidden = false;
                } else {
                    apiKeyFromConfigHint.hidden = true;
                }

                apiKeyHelpText.textContent = settings.helpText || '';

                modelSelect.innerHTML = '';
                (settings.availableModels || []).forEach(function (modelName) {
                    const option = document.createElement('option');
                    option.value = modelName;
                    option.textContent = modelName;
                    if (modelName === settings.model) {
                        option.selected = true;
                    }
                    modelSelect.appendChild(option);
                });
            }

            providerSelect.addEventListener('change', function () {
                applyProvider(providerSelect.value);
            });
        })();
    </script>
}
